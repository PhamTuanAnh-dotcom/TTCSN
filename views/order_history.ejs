<h2>📜 Lịch sử Order hôm nay</h2>

<% if (orders.length === 0) { %>
    <p>Hôm nay chưa có Order nào.</p>
<% } else { %>

<table border="1" cellpadding="10">
    <tr>
        <th>Mã Order</th>
        <th>Thời gian</th>
        <th>Bàn</th>
        <th>Nhân viên</th>
    </tr>

    <% orders.forEach(o => { %>
        <tr>
            <td><%= o.MaOder %></td>
            <td><%= new Date(o.ThoiGian).toLocaleString("vi-VN") %></td>
            <td><%= o.MaBan %></td>
            <td><%= o.NhanVien %></td>
        </tr>
    <% }) %>

</table>

<% } %>

<br>
